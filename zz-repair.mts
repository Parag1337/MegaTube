import 'dotenv/config';
import { repairVideoThumbnail } from './lib/thumbs/repair';
const userId = 'cmtvnzp610000ftijzbjbuuak';
const vid = Number(process.argv[2]);
const force = process.argv[3] === 'force';
console.log(`repairing video ${vid} force=${force}...`);
const t0 = Date.now();
const r = await repairVideoThumbnail(userId, vid, { force });
console.log('result:', JSON.stringify(r), `elapsed=${Math.round((Date.now() - t0) / 1000)}s`);
process.exit(0);
