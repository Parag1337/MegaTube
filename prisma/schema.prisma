generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "sqlite"
}

model Creator {
  id          Int      @id @default(autoincrement())
  userId      String
  name        String
  slug        String
  avatar      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model Video {
  id                 Int          @id @default(autoincrement())
  megaAccountId      Int?
  megaUrl            String?
  megaFileId         String?
  megaFileKey        String?
  megaFilename       String
  megaNodeId         String?
  parentNodeId       String?
  fileKeyEncrypted   String?
  title              String
  slug               String       @unique
  creatorId          Int?
  creatorAssignment  String?      @default("none") // "none", "auto", "manual"
  fileSize           BigInt?
  mimeType           String?
  duration           Int?
  thumbnail          String?
  thumbnailAvailable Boolean      @default(false)
  embedUrl           String?
  sortOrder          Int          @default(0)
  tags               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  /// Raw MEGA file-attribute list - used to detect new thumbnails/media attrs.
  megaFa             String?
  /// MEGA node timestamp (upload/modify time) - used for change detection.
  megaModifiedAt     DateTime?
  creator            Creator?     @relation(fields: [creatorId], references: [id])
  megaAccount        MegaAccount? @relation(fields: [megaAccountId], references: [id], onDelete: Cascade)
  watchlistedBy      WatchlistItem[]
  savedBy            SavedVideo[]
  watchHistory       WatchHistory[]

  @@unique([megaAccountId, megaNodeId])
  @@index([creatorId, createdAt])
  @@index([sortOrder])
  @@index([title])
  @@index([megaAccountId, createdAt])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  megaAccounts MegaAccount[]
  sessions     Session[]
  creators     Creator[]
  watchlist    WatchlistItem[]
  savedVideos  SavedVideo[]
  watchHistory WatchHistory[]
}

/// A MEGA account linked to a website user. One website user can link many
/// MEGA accounts; one MEGA account belongs to exactly one website user.
///
/// Status lifecycle:
/// CONNECTED         - session material stored, not yet (re)synced
/// SYNCING           - a sync job is running
/// SYNCED            - last sync completed successfully
/// REAUTH_REQUIRED   - MEGA session expired/revoked/invalid; user must
/// re-enter MEGA credentials (no auto-retry)
/// ERROR             - last sync failed with a (transient) error; the
/// scheduler retries with backoff
/// DISCONNECTED      - user removed the account; session material deleted.
/// Video rows are preserved and hidden until the same
/// MEGA email is linked again.
model MegaAccount {
  id                      Int       @id @default(autoincrement())
  userId                  String
  label                   String
  megaEmail               String
  /// MEGA user id (e.g. "Uxxxxxxxxx") from the authenticated API.
  megaUserId              String?
  /// AES-256-GCM encrypted session material (format: "v1.<base64url(iv|ct|tag)>").
  /// Plaintext JSON inside: { v, sid, masterKey, rsa, user, name, email }.
  /// Never store the MEGA password; the password is used once at login and
  /// discarded.
  encryptedSession        String
  status                  String    @default("CONNECTED")
  lastAuthenticatedAt     DateTime?
  lastSyncStartedAt       DateTime?
  lastSyncCompletedAt     DateTime?
  lastSyncErrorAt         DateTime?
  /// Sanitized, human-readable sync error (never contains secrets).
  lastSyncError           String?
  consecutiveSyncFailures Int       @default(0)
  /// Denormalized count of visible videos (updated on sync / disconnect).
  videoCount              Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  /// Durable metadata of the LAST sync attempt/completion: JSON string with
  /// { startedAt, completedAt, durationMs, discovered, totalVideos, created,
  /// updated, removed, unchanged, outcome: 'completed'|'failed'|'interrupted' }.
  /// Written by the sync worker and by crash recovery; the UI uses it to show
  /// the final result and to recover progress state after a server restart.
  lastSyncMeta            String?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos                  Video[]

  @@unique([userId, megaEmail])
  @@index([userId])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// P2.0 product foundation: a user's Watchlist. One row per (user, video);
/// video metadata is never duplicated here - always reached via the relation.
model WatchlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  videoId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, createdAt])
}

/// P2.0 product foundation: a user's saved/bookmark videos. Flat bookmarks -
/// NOT collections/folders. One row per (user, video).
model SavedVideo {
  id        Int      @id @default(autoincrement())
  userId    String
  videoId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, createdAt])
}

/// P2.0 product foundation: "videos I watched" history. One logical row per
/// (user, video); re-watching updates lastWatchedAt instead of duplicating.
/// No analytics, no sessions, no watch-time tracking.
model WatchHistory {
  id            Int      @id @default(autoincrement())
  userId        String
  videoId       Int
  lastWatchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, lastWatchedAt])
}
