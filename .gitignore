# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# perf/benchmark build outputs (NEXT_DIST_DIR overrides; Phase 1-2 feature)
/.next-perf/
/.tmp-bench/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# remuxed-MP4 playback cache (regenerable; can be large)
/data/cache-media/*

# video thumbnail cache (regenerable per video from MEGA; host-local only)
/data/thumbs/*

# production database backups (pg_dump of the live DB; contains secrets -
# NEVER commit; the *.dump/.sql/.gz forms are all covered)
/data/backups/*

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent state
.ob1/

# Phase 5 hover/timeline preview store (regenerable; LRU-bounded)
/data/previews/*
