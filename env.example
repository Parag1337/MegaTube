# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# SQLite database (relative to the project root).
DATABASE_URL="file:./data/database/app.db"

# Videos per page (homepage, search, creator pages). Default 24.
VIDEOS_PER_PAGE="24"

# ---- MEGA account linking (Phase 2) -------------------------------------
# Envelope key for encrypting stored MEGA session material and per-video
# file keys at rest (AES-256-GCM). 64 hex characters (32 bytes).
# REQUIRED for MEGA linking to work. Generate with:  npm run keygen
# Rotating this key invalidates all stored sessions (users must reconnect).
# NEVER commit the real value.
MEGA_SESSION_ENCRYPTION_KEY=""

# Optional: pepper appended to website password hashing (defense in depth).
AUTH_PEPPER=""

# ---- MEGA synchronization (Phase 3) --------------------------------------
# How often a linked MEGA account is automatically re-synced (ms). Default 6h.
# MEGA_SYNC_INTERVAL_MS="21600000"
# Max simultaneous sync jobs across accounts (default 1).
# MEGA_SYNC_CONCURRENCY="1"

# ---- Integration testing (optional) ---------------------------------------
# A DEDICATED MEGA test account (not a personal one) to run the real
# end-to-end MEGA integration/E2E tests. If unset, those tests are skipped.
# NEVER commit real credentials.
# MEGA_TEST_EMAIL=""
# MEGA_TEST_PASSWORD=""
# Second test account for multi-account E2E journeys (optional).
# MEGA_TEST_EMAIL_B=""
# MEGA_TEST_PASSWORD_B=""
