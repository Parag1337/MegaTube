import 'dotenv/config';
import fs from 'node:fs';
import { prisma } from './lib/db';
import { decryptSecret } from './lib/mega/envelope';
import { withMegaSession } from './lib/sync/session-cache';
import { getTemporaryDownloadUrl } from './lib/mega/account';
import { keepAliveFetch } from './lib/net-resilience';
import { decrypt } from 'megajs';
import { pipeline } from 'node:stream/promises';
import { Readable } from 'node:stream';
const v = await prisma.video.findUniqueOrThrow({ where: { id: 168 }, include: { megaAccount: true } });
const key = decryptSecret(v.fileKeyEncrypted!);
const { url, size } = await withMegaSession(v.megaAccountId!, v.megaAccount!.encryptedSession, async (s: any) => getTemporaryDownloadUrl(s, v.megaNodeId!));
console.log('size:', size, 'fileSize:', v.fileSize?.toString());
const end = Math.min(64 * 1024 * 1024, size ?? Number(v.fileSize)) - 1;
const res = await keepAliveFetch(`${url}/0-${end}`);
console.log('status:', res.status);
const d: any = decrypt(key, { start: 0, disableVerification: false });
const cipher: any = Readable.fromWeb(res.body as any);
await pipeline(cipher.pipe(d), fs.createWriteStream('/tmp/v168.bin'));
const st = fs.statSync('/tmp/v168.bin');
console.log('wrote:', st.size);
process.exit(0);
